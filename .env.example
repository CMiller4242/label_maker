# Postgres connection used by Prisma (packages/database) and the API.
# Host port 5433 (container still listens on 5432 internally) avoids
# conflicting with an existing local PostgreSQL instance already running on
# the default host port 5432 - see docker-compose.yml.
DATABASE_URL="postgresql://label_maker:label_maker@localhost:5433/label_maker?schema=public"

# Redis connection used by BullMQ (apps/api enqueue side, apps/worker consume side).
REDIS_URL="redis://localhost:6379"

# HTTP port the Fastify API listens on.
API_PORT=3000
API_HOST="0.0.0.0"

# Local disk storage roots (development only). Relative paths resolve from the repo root.
STORAGE_UPLOADS_DIR="./storage/uploads"
STORAGE_ARTIFACTS_DIR="./storage/artifacts"

# Root directory for source label templates (e.g. fixtures/label-templates/avery-5155/original.docx).
# LabelTemplate.templateStorageKey is a path relative to this root.
TEMPLATES_ROOT_DIR="./fixtures/label-templates"

# Maximum accepted upload size, in bytes. Defaults to 50 MB.
MAX_UPLOAD_BYTES=52428800

# Log level for pino (api and worker): fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Node environment
NODE_ENV="development"
