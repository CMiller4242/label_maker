{
  "name": "label-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "dev": "pnpm --parallel -r --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "db:generate": "pnpm --filter @label-maker/database run prisma:generate",
    "db:migrate": "pnpm --filter @label-maker/database run migrate",
    "db:seed": "pnpm --filter @label-maker/database run seed",
    "fixtures:xlsx": "tsx scripts/create-xlsx-fixtures.ts",
    "inspect:docx": "tsx scripts/inspect-docx-template.ts",
    "docx:sample-5155": "tsx scripts/generate-sample-avery-5155.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@label-maker/docx-renderer": "workspace:*",
    "@label-maker/label-layout": "workspace:*",
    "@label-maker/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "xlsx": "^0.18.5"
  },
  "packageManager": "pnpm@10.33.0"
}
